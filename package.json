        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/schedule": "^6.0.1",
        "@nestjs/swagger": "^11.2.0",
        "@types/uuid": "^10.0.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^17.2.2",
        "express-rate-limit": "^8.1.0",
        "helmet": "^8.1.0",
        "mongoose": "^8.18.2",
        "nest-winston": "^1.10.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "uuid": "^13.0.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
