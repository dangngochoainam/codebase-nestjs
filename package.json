{
    "name": "codebase-nestjs",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dangngochoainam/codebase-nestjs.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "lint-staged": {
        "src/**/*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "bugs": {
        "url": "https://github.com/dangngochoainam/codebase-nestjs/issues"
    },
    "homepage": "https://github.com/dangngochoainam/codebase-nestjs#readme",
    "dependencies": {
